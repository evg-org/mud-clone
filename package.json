      "types": "./dist/components/input.d.ts",
      "import": "./dist/components/input.js"
    },
    "./components/link": {
      "types": "./dist/components/link.d.ts",
      "import": "./dist/components/link.js"
    },
    "./components/menu": {
      "types": "./dist/components/menu.d.ts",
      "import": "./dist/components/menu.js"
    },
    "./components/modal": {
      "types": "./dist/components/modal.d.ts",
      "import": "./dist/components/modal.js"
    },
    "./components/mud-icon": {
      "types": "./dist/components/mud-icon.d.ts",
      "import": "./dist/components/mud-icon.js"
    },
    "./components/mud-logo": {
