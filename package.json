{
  "name": "mud-clone",
  "private": true,
  "version": "0.0.1-prototype.2",
  "description": "React implementation of the Moldova government MUD design system, extended for reusable product patterns.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "ATTRIBUTION.md",
    "dist",
    "docs",
    "examples",
    "scripts",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "dist/assets/**/*",
    "src/assets/**/*"
  ],
  "scripts": {
    "build": "npm run check:assets && npm run check:colors && npm run check:typography && vite build --config ./vite.config.ts && npm run build:types && npm run copy:build-assets && npm run check:build-output",
    "build:playground": "vite build --config ./examples/playground/vite.config.ts",
    "build:types": "tsc -p ./tsconfig.declarations.json && npm run fix:declarations",
    "check": "npm run check:assets && npm run check:exports && npm run check:colors && npm run check:typography",
    "check:assets": "node ./scripts/generate-asset-registries.mjs --check",
    "check:build-output": "node ./scripts/check-build-output.mjs",
    "check:consumer": "npm run build && node ./scripts/check-consumer-package.mjs",
    "check:colors": "node ./scripts/check-color-aliases.mjs",
    "check:exports": "node ./scripts/check-package-exports.mjs",
    "check:typography": "node ./scripts/check-typography-aliases.mjs",
    "copy:build-assets": "node ./scripts/copy-package-assets.mjs",
    "dev:playground": "vite --config ./examples/playground/vite.config.ts",
    "fix:declarations": "node ./scripts/fix-declaration-imports.mjs",
    "generate:assets": "node ./scripts/generate-asset-registries.mjs",
    "prepare": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/accordion": {
      "types": "./dist/components/accordion.d.ts",
      "import": "./dist/components/accordion.js"
    },
    "./components/avatar": {
      "types": "./dist/components/avatar.d.ts",
      "import": "./dist/components/avatar.js"
    },
    "./components/badge": {
      "types": "./dist/components/badge.d.ts",
      "import": "./dist/components/badge.js"
    },
    "./components/button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js"
    },
    "./components/checkbox": {
      "types": "./dist/components/checkbox.d.ts",
      "import": "./dist/components/checkbox.js"
    },
    "./components/chip": {
      "types": "./dist/components/chip.d.ts",
      "import": "./dist/components/chip.js"
    },
