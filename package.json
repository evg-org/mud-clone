    },
    "./components/switch": {
      "types": "./dist/components/switch.d.ts",
      "import": "./dist/components/switch.js"
    },
    "./components/table": {
      "types": "./dist/components/table.d.ts",
      "import": "./dist/components/table.js"
    },
    "./components/table-card": {
      "types": "./dist/components/table-card.d.ts",
      "import": "./dist/components/table-card.js"
    },
    "./components/tabs": {
      "types": "./dist/components/tabs.d.ts",
      "import": "./dist/components/tabs.js"
    },
    "./components/tag": {
      "types": "./dist/components/tag.d.ts",
      "import": "./dist/components/tag.js"
    },
    "./components/tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/components/tooltip.js"
    },
    "./components/textarea": {
      "types": "./dist/components/textarea.d.ts",
      "import": "./dist/components/textarea.js"
    },
    "./styles/design-system.css": "./dist/styles/design-system.css",
    "./styles/fonts.css": "./dist/styles/fonts.css"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "tailwind-merge": "3.2.0"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "5.9.3",
    "vite": "6.3.5"
  }
}
